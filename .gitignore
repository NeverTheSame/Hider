out/
logs/
*.log

# Local, uncommitted configuration
vault.json
profile.json
*.profile.json
hider.local.json
.claude/settings.local.json

# Credentials and real data must never be committed
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
data/raw/

# Model weight files
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5
*.joblib
*.bin
